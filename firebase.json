{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "power9-office-se180724",
          "appId": "1:613232000873:android:f65f6f74ecdc93e31407f8",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "power9-office-se180724",
          "configurations": {
            "android": "1:613232000873:android:f65f6f74ecdc93e31407f8"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "hosting": {
    "public": "web/build/hosting",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/{,index.html,flutter_bootstrap.js,flutter_service_worker.js,main.dart.js}",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      }
    ],
    "rewrites": [{"source": "**", "destination": "/index.html"}]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "storage": {
      "port": 9199
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "storage": {
    "rules": "firebase/storage.rules"
  }
}
