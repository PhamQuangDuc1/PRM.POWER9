rules_version = '2';
// Reports contain owner-only PDF metadata. A null storagePath denotes a local PDF.
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /users/{uid} {
      allow get: if owner(uid) || isAdmin();
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['role'])
        && request.resource.data.role == 'user';
      allow update: if isAdmin() && !owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && request.resource.data.role in ['user', 'admin'];
    }
    match /activityProposals/{id} {
      function ownsProposalId() {
        return request.auth != null && id.split('~').size() == 2
          && id.split('~')[0] == request.auth.uid;
      }
      function validSubmission() {
        let d = request.resource.data;
        let fields = ['ownerUid', 'title', 'groupId', 'minutes', 'description', 'status', 'createdAt'];
        return d.keys().hasAll(fields) && d.keys().hasOnly(fields)
          && owner(d.ownerUid) && ownsProposalId()
          && d.title is string && d.title.size() >= 3 && d.title.size() <= 120
          && d.groupId in ['move', 'posture', 'eat', 'sleep', 'stress', 'space', 'social', 'purpose', 'balance']
          && d.minutes is int && d.minutes >= 1 && d.minutes <= 60
          && d.description is string && d.description.size() >= 5 && d.description.size() <= 1000
          && d.status == 'pending' && d.createdAt == request.time;
      }
      function validDecision() {
        let d = request.resource.data;
        return resource.data.status == 'pending'
          && d.diff(resource.data).affectedKeys().hasOnly(['status', 'reason', 'reviewedAt', 'reviewerUid'])
          && d.status in ['approved', 'rejected']
          && d.reason is string && d.reason.size() >= 3 && d.reason.size() <= 500
          && owner(d.reviewerUid) && d.reviewedAt == request.time;
      }
      function validPublication() {
        let activityId = request.resource.data.publishedActivityId;
        let path = /databases/$(database)/documents/activities/$(activityId);
        let activity = getAfter(path).data;
        return resource.data.status == 'approved'
          && !('publishedActivityId' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['publishedActivityId'])
          && !exists(path)
          && activity.published == true
          && activity.title == resource.data.title
          && activity.groupId == resource.data.groupId
          && activity.minutes == resource.data.minutes
          && activity.purpose == resource.data.description;
      }
      allow get: if isAdmin() || ownsProposalId();
      allow list: if isAdmin() || owner(resource.data.ownerUid);
      allow create: if !isAdmin() && validSubmission();
      allow update: if isAdmin() && (validDecision() || validPublication());
    }
    match /activities/{activityId} {
      allow read: if request.auth != null && resource.data.published == true;
      function validStep(steps, index) {
        return steps.size() <= index
          || (steps[index] is string && steps[index].size() <= 1000);
      }
      function validNewActivity() {
        let d = request.resource.data;
        let groups = ['move','posture','eat','sleep','stress','space','social','purpose','balance'];
        return d.keys().hasOnly(['title', 'groupId', 'groupName', 'minutes',
            'purpose', 'steps', 'note', 'rank', 'published'])
          && d.title is string && d.title.size() >= 3 && d.title.size() <= 120
          && d.groupId in groups && d.groupName is string
          && d.groupName.size() >= 1 && d.groupName.size() <= 60
          && d.minutes is int && d.minutes >= 1 && d.minutes <= 60
          && d.purpose is string && d.purpose.size() >= 5 && d.purpose.size() <= 1000
          && d.steps is list && d.steps.size() <= 5
          && validStep(d.steps, 0) && validStep(d.steps, 1) && validStep(d.steps, 2)
          && validStep(d.steps, 3) && validStep(d.steps, 4)
          && d.note is string && d.note.size() <= 500
          && d.rank is int && d.rank >= 0 && d.rank <= 1000
          && d.published is bool;
      }
      allow read: if isAdmin();
      allow create: if isAdmin() && validNewActivity();
      allow update: if isAdmin()
        && (!(activityId in ['eat-lunch', 'stress-break']) || request.resource.data.published == true)
        && (validNewActivity()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['published'])
          && request.resource.data.published is bool));
    }
    match /announcements/{id} {
      allow read: if request.auth != null;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['title','body','createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 3 && request.resource.data.body.size() <= 1000
        && request.resource.data.createdAt == request.time;
    }
    match /users/{uid}/schedules/{id} {
      function validSchedule() {
        let d = request.resource.data;
        let activity = get(/databases/$(database)/documents/activities/$(d.activityId)).data;
        return d.keys().hasAll(['activityId', 'title', 'groupId', 'dateKey', 'minuteOfDay', 'reminderEnabled', 'createdAt', 'updatedAt'])
          && d.keys().hasOnly(['activityId', 'title', 'groupId', 'dateKey', 'minuteOfDay', 'reminderEnabled', 'createdAt', 'updatedAt'])
          && d.activityId is string && d.dateKey is string
          && d.dateKey.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && id == d.activityId + '_' + d.dateKey
          && activity.published == true && d.title == activity.title && d.groupId == activity.groupId
          && d.reminderEnabled is bool
          && (d.minuteOfDay == null || (d.minuteOfDay is int && d.minuteOfDay >= 0 && d.minuteOfDay < 1440))
          && (!d.reminderEnabled || d.minuteOfDay is int)
          && d.createdAt is timestamp && d.updatedAt == request.time;
      }
      allow read, delete: if owner(uid);
      allow create: if owner(uid) && validSchedule() && request.resource.data.createdAt == request.time;
      allow update: if owner(uid) && validSchedule()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.activityId == resource.data.activityId
        && request.resource.data.dateKey == resource.data.dateKey;
    }
    match /users/{uid}/completions/{id} {
      function validCompletion() {
        let d = request.resource.data;
        let activity = get(/databases/$(database)/documents/activities/$(d.activityId)).data;
        return d.keys().hasAll(['activityId','title','groupId','dateKey','source','durationSeconds','createdAt'])
          && d.keys().hasOnly(['activityId','title','groupId','dateKey','source','durationSeconds','createdAt'])
          && d.activityId is string && d.dateKey is string
          && d.dateKey.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && id == d.activityId + '_' + d.dateKey
          && activity.published == true && d.title == activity.title && d.groupId == activity.groupId
          && d.source in ['checkin','timer','checklist']
          && ((d.source == 'timer' && d.durationSeconds is int && d.durationSeconds >= 1 && d.durationSeconds <= activity.minutes * 60)
            || (d.source != 'timer' && d.durationSeconds == null))
          && d.createdAt == request.time;
      }
      allow read, delete: if owner(uid);
      allow create: if owner(uid) && validCompletion();
      allow update: if false;
    }
    match /users/{uid}/reports/{id} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasAll(['dateKey','fileName','storagePath','byteLength','sha256','createdAt'])
        && request.resource.data.keys().hasOnly(['dateKey','fileName','storagePath','byteLength','sha256','createdAt'])
        && id.matches('[a-f0-9]{64}') && request.resource.data.sha256 == id
        && request.resource.data.dateKey.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.fileName.matches('Power9-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-f0-9]{12}\\.pdf')
        && (request.resource.data.storagePath == null
          || request.resource.data.storagePath == 'reports/' + uid + '/' + id + '.pdf')
        && request.resource.data.byteLength is int && request.resource.data.byteLength > 0 && request.resource.data.byteLength <= 10 * 1024 * 1024
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
