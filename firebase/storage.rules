rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /reports/{uid}/{fileName} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      allow read, delete: if owner();
      allow create, update: if owner()
        && fileName.matches('[a-f0-9]{64}\\.pdf')
        && request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf'
        && request.resource.metadata.schemaVersion == '1'
        && request.resource.metadata.dateKey.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
